			"    int n = txt.size();",
			"    int m = pat.size();",
			"    vector<int> lps(m, 0);",
			"    vector<int> result;",
			"",
			"    longestPrefixSuffix(pat, lps);",
			"",
			"    int i = 0;",
			"    int j = 0; ",
			"    while (i < n) {",
			"        if (pat[j] == txt[i]) {",
