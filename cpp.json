	"used to find the string matching using hashing . O-based indexing is used .": {
		"prefix": "RabinKarp",
		"body": [
			"class StringHasher",
			"{",
			"public:",
			"    vi pref;",
			"    vi base_pow;",
			" ",
			"    StringHasher(const string &s)",
			"    {",
			"        int n = s.size();",
			"        pref.resize(n);",
			"        base_pow.resize(n);",
			"        pref[0] = s[0] - 'a' + 1;",
			"        base_pow[0] = 1;",
			"        for (int i = 1; i < n; i++)",
			"        {",
			"            base_pow[i] = modmul(base_pow[i - 1], BASE);",
			"            pref[i] = modadd(modmul(pref[i - 1], BASE), s[i] - 'a' + 1);",
			"        }",
			"    }",
			" ",
			"    int get_hash(int l, int r)",
			"    {",
			"        if (l <= 0)",
			"            return pref[r];",
			"        int h = modsub(pref[r], modmul(base_pow[r - l + 1], pref[l - 1]));",
			"        return h;",
			"    }",
			"};",
			" ",
			"bool verify_match(const string &txt, const string &pat, int start_pos)",
			"{",
			"    if (start_pos + pat.size() > txt.size())",
			"        return false;",
			"    for (int i = 0; i < pat.size(); i++)",
			"    {",
			"        if (txt[start_pos + i] != pat[i])",
			"            return false;",
			"    }",
			"    return true;",
			"}",
