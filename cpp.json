	"binary exponentiation": {
		"prefix": "modexpo",
		"body": [
			"int modExpo(int a, int b, int mod=MOD) {",
			"    int result = 1;",
			"    a = a % mod;",
			"    while (b > 0) {",
			"        if (b & 1) {",
			"            result=modmul(result, a,mod);",
			"        }",
			"        a=modmul(a, a,mod);",
			"        b = b >> 1;",
			"    }",
			"return result;",
			"}",
			"int modinv(int a,int p=MOD){",
			"return modExpo(a,p-2,p);",
			"}"
		],
		"description": "binary exponentiation"
