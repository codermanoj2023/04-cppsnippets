			"    matrix friend operator *(const matrix &a, const matrix &b){",
			"        matrix c;",
			"        for (int i = 0; i < 2; i++) {",
			"          for (int j = 0; j < 2; j++) {",
			"              c.mat[i][j] = 0;",
			"              for (int k = 0; k < 2; k++) {",
			"                c.mat[i][j]=modadd(c.mat[i][j],modmul(a.mat[i][k],b.mat[k][j]));",
			"              }",
			"          }",
			"        }",
			"        return c;",
			"    }",
			"};",
			"",
			"matrix matpow(matrix base, int n) {",
			"    matrix ans{ {",
			"      {1, 0},",
			"      {0, 1}",
			"    } };",
			"    while (n) {",
			"        if(n&1)",
			"            ans = ans*base;",
			"        base = base*base;",
			"        n >>= 1;",
			"    }",
