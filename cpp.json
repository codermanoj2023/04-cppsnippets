			"    int i = 0;",
			"    for (int j = 1; j < n; j++)",
			"    {",
			"        if (str[j] == str[i])",
			"        {",
			"            dp[j] = dp[j - 1] + 1;",
			"            i++;",
			"        }",
			"        else",
			"        {",
			"            while (i > 0)",
			"            {",
			"                i = dp[i - 1];",
			"                if (str[j] == str[i])",
			"                {",
