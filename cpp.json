	"implementing segment tree using iterations": {
		"prefix": "iterativesegmenttree",
		"body": [
			"template <class T>",
			"class MinSegmentTree",
			"{",
			"private:",
			"    const T DEFAULT = numeric_limits<T>().max();",
			"",
			"    vector<T> segtree;",
			"    int len;",
			"",
			"public:",
			"    MinSegmentTree(int len) : len(len), segtree(len * 2, DEFAULT) {}",
			"",
			"    void set(int ind, T val)",
			"    {",
			"        ind += len;",
			"        segtree[ind] = val;",
			"        for (; ind > 1; ind /= 2)",
			"        {",
			"            segtree[ind / 2] = min(segtree[ind], segtree[ind ^ 1]);",
			"        }",
			"    }",
			"",
			"    // here in range_min, end is not included",
			"    T range_min(int start, int end)",
			"    {",
			"        T minny = DEFAULT;",
			"        for (start += len, end += len; start < end; start /= 2, end /= 2)",
			"        {",
			"            if (start % 2 == 1)",
			"            {",
			"                minny = min(minny, segtree[start++]);",
			"            }",
			"            if (end % 2 == 1)",
			"            {",
			"                minny = min(minny, segtree[--end]);",
			"            }",
			"        }",
			"        return minny;",
			"    }",
			"};",
			""
		],
		"description": "implementing segment tree using iterations"
	},
