			"        for (int i = 0; i < a.size(); i++)",
			"        {",
			"            arr[i+1] = a[i];",
			"            update(i+1, a[i]);",
			"        }",
			"    }",
			"    ",
			"    void update(int i, int add)",
			"    {",
			"        while (i <= n)  ",
			"        {",
			"            fen[i] += add;",
			"            i += (i & (-i));",
			"        }",
			"    }",
			"    ",
			"    void pointUpdate(int i, int val) {",
			"        int diff = val - arr[i];",
			"        arr[i] = val;",
			"        update(i, diff);",
			"    }",
			"",
			"    int sum(int i)",
			"    {",
			"        int s = 0;",
			"        while (i > 0)",
			"        {",
			"            s += fen[i];",
			"            i -= (i & (-i));",
			"        }",
			"        return s;",
			"    }",
			"",
			"    int rangeSum(int l, int r)",
			"    {",
			"        return sum(r) - sum(l - 1);",
			"    }",
