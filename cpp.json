			"void floydWarshall(vector<vector<int>> &grid)",
			"{",
			"    int n = grid.size();",
			"    for (int inter = 0; inter < n; inter++)",
			"    for (int i = 0; i < n; i++)",
			"    for (int j = 0; j < n; j++)",
			"    {",
			"        if (grid[i][inter] == MAX_VAL || grid[inter][j] == MAX_VAL)",
			"            continue;",
			"        grid[i][j] = min(grid[i][j], grid[i][inter] + grid[inter][j]);",
			"    }    ",
			"    return;",
			"}"
		],
